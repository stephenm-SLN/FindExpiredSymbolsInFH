# pixi environments
.pixi/*
!.pixi/config.toml

# Local secrets (NEVER commit)
.DBCreds.*

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build & packaging artefacts (regenerated by `python -m build` /
